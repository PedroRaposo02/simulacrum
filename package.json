{
  "name": "wf-builds",
  "version": "0.6.0-beta.1",
  "private": true,
  "scripts": {
    "ingest": "pnpm --filter @wf/ingest run ingest",
    "dev": "pnpm --filter @wf/web run dev",
    "build:wasm": "pnpm --filter @wf/web run build:wasm",
    "build": "pnpm --filter @wf/web run build",
    "optimize": "cargo run --release -p wf-cli -- optimize --all && node -e \"const f=require('fs');f.mkdirSync('apps/web/public',{recursive:true});f.copyFileSync('data/best-builds.json','apps/web/public/best-builds.json')\"",
    "test": "cargo test --workspace"
  }
}
